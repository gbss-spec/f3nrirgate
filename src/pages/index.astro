---
import BaseLayout from "../layouts/BaseLayout.astro";

const skills = [
  { name: "Inglês", detail: "English · ESL C2", tier: "Avançado" },
  { name: "Japonês", detail: "Japanese · JLPT N5", tier: "Iniciante" },
  { name: "C", tier: "Intermediário" },
  { name: "Python", tier: "Iniciante" },
  { name: "SQL", tier: "Iniciante" },
  { name: "MicroPython", tier: "Intermediário" },
  { name: "Física", tier: "Familiar" },
  { name: "Cálculo", tier: "Familiar" },
  { name: "HTML", tier: "Familiar" },
  { name: "CSS", tier: "Familiar" },
  { name: "Desenvolvimento e compreensão de Hardware", tier: "Iniciante" },
  { name: "Conceitos de Cybersegurança", tier: "Familiar" },
];

const tierMeta = {
  "Iniciante": {
    level: 1,
    tagClass: "border-cyber-tierBeginner/50 bg-cyber-tierBeginner/10 text-cyber-tierBeginner",
    fillClass: "bg-cyber-tierBeginner",
  },
  "Familiar": {
    level: 2,
    tagClass: "border-cyber-tierFamiliar/50 bg-cyber-tierFamiliar/10 text-cyber-tierFamiliar",
    fillClass: "bg-cyber-tierFamiliar",
  },
  "Intermediário": {
    level: 3,
    tagClass: "border-cyber-tierIntermediate/50 bg-cyber-tierIntermediate/10 text-cyber-tierIntermediate",
    fillClass: "bg-cyber-tierIntermediate",
  },
  "Avançado": {
    level: 4,
    tagClass: "border-cyber-tierAdvanced/50 bg-cyber-tierAdvanced/10 text-cyber-tierAdvanced",
    fillClass: "bg-cyber-tierAdvanced",
  },
};
const levelScale = [1, 2, 3, 4];
---

<BaseLayout
  title="Givaldo Batista da Silva Sobrinho // f3nrir"
  description="Portfólio minimalista em vermelho e preto."
>
  <section class="mb-4 rounded-lg border border-cyber-line bg-cyber-panel/90 p-4">
    <p class="text-[10px] tracking-widest text-cyber-muted">&gt; profile.init</p>

    <div class="mt-3 grid gap-4 md:grid-cols-[1fr_368px] md:items-start">
      <div>
        <h1 class="font-display text-xl font-semibold text-cyber-redSoft sm:text-2xl">
          Givaldo Batista da Silva Sobrinho
        </h1>

        <p class="mt-2 text-sm font-medium text-cyber-redSoft leading-relaxed">
          Engenharia da Computação
        </p>
        <p class="text-[11px] text-cyber-muted leading-relaxed">
          Computer Engineering · コンピュータ工学
          <br />
          UFAL • Cybersegurança • Sistemas Embarcados
        </p>
      </div>

      <div class="justify-self-start md:justify-self-end">
        <div class="aspect-square w-[368px] max-w-full overflow-hidden rounded-md border border-cyber-line bg-black/40 shadow-softRed">
          <img
            src="/images/profile.jpg"
            alt="Foto de Givaldo"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="mb-4 rounded-lg border border-cyber-line bg-cyber-panel/90 p-4">
    <h2 class="mb-2 text-sm font-semibold text-cyber-red">&gt; sobre <span class="text-cyber-muted font-normal">/ about</span></h2>
    <p class="text-xs leading-relaxed text-cyber-text">
      Graduando em Engenharia da Computação na UFAL, com ênfase em Cybersegurança e Sistemas Embarcados.
    </p>
  </section>

  <section class="mb-4 rounded-lg border border-cyber-line bg-cyber-panel/90 p-4">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-cyber-red">&gt; competências <span class="text-cyber-muted font-normal">/ skill tree</span></h2>
      <div class="flex flex-wrap gap-1 text-[10px]">
        <span class="rounded border border-cyber-tierBeginner/50 bg-cyber-tierBeginner/10 px-2 py-0.5 text-cyber-tierBeginner">Iniciante</span>
        <span class="rounded border border-cyber-tierFamiliar/50 bg-cyber-tierFamiliar/10 px-2 py-0.5 text-cyber-tierFamiliar">Familiar</span>
        <span class="rounded border border-cyber-tierIntermediate/50 bg-cyber-tierIntermediate/10 px-2 py-0.5 text-cyber-tierIntermediate">Intermediário</span>
        <span class="rounded border border-cyber-tierAdvanced/50 bg-cyber-tierAdvanced/10 px-2 py-0.5 text-cyber-tierAdvanced">Avançado</span>
      </div>
    </div>

    <div class="grid gap-2 sm:grid-cols-2">
      {skills.map((skill) => {
        const tier = tierMeta[skill.tier];
        return (
        <article class="rounded border border-cyber-line bg-black/30 px-3 py-2">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="text-xs font-medium text-cyber-text">{skill.name}</p>
              {skill.detail && <p class="text-[10px] text-cyber-muted">{skill.detail}</p>}
            </div>
            <span class={`rounded border px-2 py-0.5 text-[10px] ${tier.tagClass}`}>
              {skill.tier}
            </span>
          </div>
          <div class="mt-2 grid grid-cols-4 gap-1">
            {levelScale.map((level) => (
              <span class={`h-1.5 rounded-sm ${level <= tier.level ? tier.fillClass : "bg-cyber-line/70"}`}></span>
            ))}
          </div>
        </article>
      )})}
    </div>
  </section>

  <section class="mb-4 rounded-lg border border-cyber-line bg-cyber-panel/90 p-4">
    <h2 class="mb-2 text-sm font-semibold text-cyber-red">&gt; arquivos <span class="text-cyber-muted font-normal">/ archive</span></h2>
    <div class="grid gap-2 sm:grid-cols-2">
    <article class="rounded border border-cyber-line bg-black/20 p-3 text-xs text-cyber-text">
      <h3 class="text-cyber-redSoft">f3nrir.dev</h3>
      <p class="mt-1 leading-relaxed">
        Portfólio pessoal desenvolvido com assistência de IA e com o propósito de apresentar quem sou e o que faço.
      </p>
    </article>
    <article class="rounded border border-cyber-line bg-black/20 p-3 text-xs text-cyber-text">
      <h3 class="text-cyber-redSoft">BellaCosta</h3>
      <p class="mt-1 leading-relaxed">
        Ideia de jogo top-down em pixel art para narrar uma história rica localizada nas praias de Maceió. WIP, sem link.
      </p>
    </article>
    <article class="rounded border border-cyber-line bg-black/20 p-3 text-xs text-cyber-text">
      <h3 class="text-cyber-redSoft">Maceió Canoe Club website</h3>
      <p class="mt-1 leading-relaxed">
        Landing page desenvolvida para apresentar meu último local de trabalho. Atualmente o site está fora do ar, mas o repositório está disponível no meu GitHub.
      </p>
    </article>
    <article class="rounded border border-cyber-line bg-black/20 p-3 text-xs text-cyber-text">
      <h3 class="text-cyber-redSoft">Criptografia Mítica</h3>
      <p class="mt-1 leading-relaxed">
        Projeto de criptografia RSA criado para tornar seu entendimento mais didático, desenvolvido a partir do curso de Matemática Discreta do primeiro período da minha formação na UFAL.
      </p>
      <a
        class="mt-2 inline-flex rounded border border-cyber-line px-2 py-1 text-[11px] text-cyber-text hover:border-cyber-red hover:text-cyber-red"
        href="https://github.com/gbss-spec/Criptografia_Mitica"
        target="_blank"
        rel="noreferrer"
      >
        Ver repositório
      </a>
    </article>
  </div>
  </section>

  <footer class="rounded-lg border border-cyber-line bg-cyber-panel/90 p-4">
    <h2 class="mb-2 text-sm font-semibold text-cyber-red">&gt; contato <span class="text-cyber-muted font-normal">/ commlink</span></h2>
    <div class="flex flex-wrap gap-2 text-xs">
      <a class="rounded border border-cyber-line px-2 py-1 text-cyber-text hover:border-cyber-red hover:text-cyber-red" href="https://www.linkedin.com/in/givaldo-batista-da-silva-sobrinho-178a81429/" target="_blank" rel="noreferrer">LinkedIn</a>
      <a class="rounded border border-cyber-line px-2 py-1 text-cyber-text hover:border-cyber-red hover:text-cyber-red" href="https://www.instagram.com/goat.3598191" target="_blank" rel="noreferrer">Instagram</a>
      <a class="rounded border border-cyber-line px-2 py-1 text-cyber-text hover:border-cyber-red hover:text-cyber-red" href="https://cara.app/fenr-lim-0" target="_blank" rel="noreferrer">Cara.app</a>
      <a class="rounded border border-cyber-line px-2 py-1 text-cyber-text hover:border-cyber-red hover:text-cyber-red" href="mailto:jbebs_0@pm.me">Email</a>
    </div>
  </footer>
</BaseLayout>
