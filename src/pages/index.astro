---
import BaseLayout from "../layouts/BaseLayout.astro";

const skills = [
  { name: "Inglês (ESL C2)", tier: "Avançado", color: "bg-cyber-tierAdvanced" },
  { name: "Japonês (JLPT N5)", tier: "Iniciante", color: "bg-cyber-tierBeginner" },
  { name: "C", tier: "Intermediário", color: "bg-cyber-tierIntermediate" },
  { name: "Python", tier: "Iniciante", color: "bg-cyber-tierBeginner" },
  { name: "SQL", tier: "Familiar", color: "bg-cyber-tierFamiliar" },
  { name: "MicroPython", tier: "Intermediário", color: "bg-cyber-tierIntermediate" },
  { name: "Physics", tier: "Intermediário", color: "bg-cyber-tierIntermediate" },
  { name: "Calculus", tier: "Intermediário", color: "bg-cyber-tierIntermediate" },
];

const tierClasses = {
  "Iniciante": "text-cyber-tierBeginner border-cyber-tierBeginner/50",
  "Familiar": "text-cyber-tierFamiliar border-cyber-tierFamiliar/50",
  "Intermediário": "text-cyber-tierIntermediate border-cyber-tierIntermediate/50",
  "Avançado": "text-cyber-tierAdvanced border-cyber-tierAdvanced/50",
};
---

<BaseLayout
  title="Givaldo Batista da Silva Sobrinho // f3nrir"
  description="Portfólio minimalista em vermelho e preto."
>
  <section class="mb-4 rounded-lg border border-cyber-line bg-cyber-panel/90 p-4">
    <p class="text-[10px] tracking-widest text-cyber-muted">&gt; profile.init</p>

    <div class="mt-3 grid gap-4 md:grid-cols-[1fr_120px] md:items-start">
      <div>
        <!-- Nome menor e menos gritante -->
        <h1 class="font-display text-xl font-semibold text-cyber-redSoft sm:text-2xl">
          Givaldo Batista da Silva Sobrinho
        </h1>

        <p class="mt-2 text-xs text-cyber-text leading-relaxed">
          Engenharia da Computação | Computer Engineering | コンピュータ工学
          <br />
          UFAL • Cybersegurança • Sistemas Embarcados
        </p>
      </div>

      <!-- Espaço para foto -->
      <div class="justify-self-start md:justify-self-end">
        <div class="h-[120px] w-[120px] overflow-hidden rounded-md border border-cyber-line bg-black/40 shadow-softRed">
          <!-- Troque por sua imagem real -->
          <img
            src="/images/profile.jpg"
            alt="Retrato de Givaldo Batista da Silva Sobrinho"
            class="h-full w-full object-cover"
            width="120"
            height="120"
            decoding="async"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="mb-4 rounded-lg border border-cyber-line bg-cyber-panel/90 p-4">
    <h2 class="mb-2 text-sm font-semibold text-cyber-red">&gt; about</h2>
    <p class="text-xs leading-relaxed text-cyber-text">
      Graduando em Engenharia da Computação na UFAL, com ênfase em Cybersegurança e Sistemas Embarcados.
      Interesses: Maceió Canoe Club, dança, desenho, artes marciais, escrita e self-hosting (f3nrir.dev).
    </p>
  </section>

  <section class="mb-4 rounded-lg border border-cyber-line bg-cyber-panel/90 p-4">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-cyber-red">&gt; skill_tree</h2>
      <div class="flex flex-wrap gap-1 text-[10px]">
        <span class="rounded border border-cyber-tierBeginner/50 px-2 py-0.5 text-cyber-tierBeginner">Iniciante</span>
        <span class="rounded border border-cyber-tierFamiliar/50 px-2 py-0.5 text-cyber-tierFamiliar">Familiar</span>
        <span class="rounded border border-cyber-tierIntermediate/50 px-2 py-0.5 text-cyber-tierIntermediate">Intermediário</span>
        <span class="rounded border border-cyber-tierAdvanced/50 px-2 py-0.5 text-cyber-tierAdvanced">Avançado</span>
      </div>
    </div>

    <div class="grid gap-2 sm:grid-cols-2">
      {skills.map((skill) => (
        <article class="flex items-center justify-between rounded border border-cyber-line bg-black/25 px-3 py-2">
          <span class="text-xs text-cyber-text">{skill.name}</span>
          <span class={`rounded border px-2 py-0.5 text-[10px] ${tierClasses[skill.tier]}`}>
            {skill.tier}
          </span>
        </article>
      ))}
    </div>
  </section>

  <section class="mb-4 rounded-lg border border-cyber-line bg-cyber-panel/90 p-4">
    <h2 class="mb-2 text-sm font-semibold text-cyber-red">&gt; archive</h2>
    <div class="grid gap-2 sm:grid-cols-2">
      <div class="rounded border border-cyber-line bg-black/20 p-3 text-xs text-cyber-text">f3nrir.dev / Servidor Pessoal</div>
      <div class="rounded border border-cyber-line bg-black/20 p-3 text-xs text-cyber-text">Criptografia Mítica</div>
      <div class="rounded border border-cyber-line bg-black/20 p-3 text-xs text-cyber-text">Maceió Canoe Club website</div>
      <div class="rounded border border-cyber-line bg-black/20 p-3 text-xs text-cyber-text">BellaCosta</div>
    </div>
  </section>

  <footer class="rounded-lg border border-cyber-line bg-cyber-panel/90 p-4">
    <h2 class="mb-2 text-sm font-semibold text-cyber-red">&gt; commlink</h2>
    <div class="flex flex-wrap gap-2 text-xs">
      <a class="rounded border border-cyber-line px-2 py-1 text-cyber-text hover:border-cyber-red hover:text-cyber-red" href="https://www.linkedin.com/" target="_blank" rel="noreferrer">LinkedIn</a>
      <a class="rounded border border-cyber-line px-2 py-1 text-cyber-text hover:border-cyber-red hover:text-cyber-red" href="https://www.instagram.com/" target="_blank" rel="noreferrer">Instagram</a>
      <a class="rounded border border-cyber-line px-2 py-1 text-cyber-text hover:border-cyber-red hover:text-cyber-red" href="https://cara.app/" target="_blank" rel="noreferrer">Cara.app</a>
      <a class="rounded border border-cyber-line px-2 py-1 text-cyber-text hover:border-cyber-red hover:text-cyber-red" href="mailto:jbebs_0@pm.me">Email</a>
    </div>
  </footer>
</BaseLayout>
