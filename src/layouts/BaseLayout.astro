---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "f3nrir // Portfolio",
  description = "Landing page cyberpunk de Givaldo Batista da Silva Sobrinho",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Orbitron:wght@500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-cyber-bg text-cyber-text font-mono min-h-screen selection:bg-cyber-cyan/20 selection:text-cyber-cyan">
    <div class="fixed inset-0 -z-10 bg-cyber-grid bg-grid opacity-40"></div>
    <div class="fixed inset-0 -z-10 bg-cyber-noise opacity-70"></div>
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div class="h-40 w-full bg-gradient-to-b from-cyber-cyan/10 to-transparent animate-scanline"></div>
    </div>

    <main class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>
  </body>
</html>
